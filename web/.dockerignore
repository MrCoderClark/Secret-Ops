# Keep the Docker build context tiny and reproducible. Whatever reaches the
# builder stage via `COPY . .` must NOT overlap with what the deps stage
# installed into /app/node_modules, or a stale host install will overwrite
# the clean one.

# Dependencies — installed fresh inside the deps stage.
node_modules
.pnpm-store

# Build output — regenerated inside the builder stage.
.next
out
build
dist

# Secrets — never bake into an image.
.env
.env.*
!.env.example

# VCS and editor junk.
.git
.gitignore
.gitattributes
.vscode
.idea
.DS_Store
Thumbs.db

# Logs and debug artifacts.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Tests, coverage, local caches.
coverage
.nyc_output
*.tsbuildinfo

# Docker itself — the Dockerfile and compose files do not belong in the image.
Dockerfile
.dockerignore
docker-compose.yml
