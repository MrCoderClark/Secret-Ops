# Use npm-style flat node_modules instead of pnpm's isolated symlink layout.
#
# Why: Next.js standalone output tracing and Docker COPY both work better
# against a flat tree. With isolated, the generated Prisma client lives at
# node_modules/.pnpm/@prisma+client@<ver>/node_modules/.prisma/, and the
# Dockerfile's `COPY /app/node_modules/.prisma` finds nothing at the top
# level. Hoisted makes @prisma/client, .prisma/, and argon2 real directories
# at node_modules/, so the Dockerfile and runtime resolution match.
#
# Lockfile is unchanged (resolution is identical, only materialisation
# changes). Switching this later means `rm -rf node_modules && pnpm install`.
node-linker=hoisted
