# ---------------------------------------------------------------------------
# SecretOps — environment template
# Copy to `.env` and fill in. Never commit the filled file.
# ---------------------------------------------------------------------------

# Postgres connection string.
DATABASE_URL="postgresql://secretops:secretops@localhost:5432/secretops?schema=public"

# Session signing key. Generate with: openssl rand -base64 48
# Must be at least 32 characters. Required in production.
SESSION_SECRET=""

# Root encryption keys (KEK). Format: keyId:base64key, comma-separated.
# The FIRST entry is the active key used for new writes; keep older keys in
# the list so historical versions stay decryptable.
#
# Generate each key with: openssl rand -base64 32
#
# SECRETOPS_ROOT_KEYS="kek-v2:<base64>,kek-v1:<base64>"
#
# If unset in development, a fixed, insecure key is derived so the app boots.
# In production, the app refuses to start without this.
SECRETOPS_ROOT_KEYS=""

# Public origin, used in generated CLI snippets and sync agent instructions.
APP_URL="http://localhost:3000"

NODE_ENV="development"

# Worker tuning
ROTATION_SWEEP_CRON="0 3 * * *"   # daily at 03:00
DRIFT_SWEEP_CRON="*/30 * * * *"   # every 30 minutes
